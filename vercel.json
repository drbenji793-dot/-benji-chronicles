{
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/latest.html",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Chronicles.html\""
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "buildCommand": "npm run release:check && npm run build && node arrow-pages.mjs public && node scripts/latest-html.mjs public/index.html \"$(node -p \"process.env.SITE_LANGUAGE==='en'?'benji-chronicles-english.vercel.app':'benji-chronicles.vercel.app'\")\"",
  "installCommand": "npm ci --ignore-scripts"
}
